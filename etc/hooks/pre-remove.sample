#!/usr/bin/env bash
#
# pre-remove hook - Runs before removing paths or deleting a profile
#
# This script runs before dotta removes paths from a profile or deletes
# a profile entirely. Use it to back up the paths, validate the removal,
# or prevent accidental deletion of critical configuration.
#
# Exit with non-zero status to abort the remove operation.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("remove")
#   DOTTA_PROFILE     - Profile name being modified or deleted
#   DOTTA_PATH_COUNT  - Number of paths: one per path the removal takes a
#                       claim at, a directory the profile tracks as well as a
#                       file (every path the profile tracks, when it is
#                       deleted), each once, however many claims stand there;
#                       a directory it only passes through is none of them
#   DOTTA_PATH_0      - First path (0-indexed)
#   DOTTA_PATH_1      - Second path
#   DOTTA_PATH_N      - Nth path (where N = 0 to COUNT-1)
#   DOTTA_DRY_RUN     - "1" if dry-run, "0" otherwise
#

set -euo pipefail

if [[ "${DOTTA_DRY_RUN:-0}" == "1" ]]; then
    echo "Pre-remove: dry-run, skipping backup."
    exit 0
fi

# Example: Snapshot the paths about to be removed into a timestamped directory
backup_dir="$HOME/.dotta-backups/remove-$(date +%Y%m%d-%H%M%S)-$DOTTA_PROFILE"

if [[ "$DOTTA_PATH_COUNT" -gt 0 ]]; then
    mkdir -p "$backup_dir"
    echo "Pre-remove: backing up $DOTTA_PATH_COUNT path(s) to $backup_dir"

    for ((i=0; i<DOTTA_PATH_COUNT; i++)); do
        var_name="DOTTA_PATH_$i"
        path="${!var_name}"
        if [[ -e "$path" ]]; then
            # Preserve the source path relative to home for easy restore; a
            # directory is copied whole
            rel="${path#$HOME/}"
            target="$backup_dir/$rel"
            mkdir -p "$(dirname "$target")"
            cp -aL "$path" "$target" 2>/dev/null || true
        fi
    done
else
    # Nothing taken: a profile deleted while it claims nothing. Its branch
    # remains in Git history until pruned.
    echo "Pre-remove: deleting profile '$DOTTA_PROFILE' (nothing to back up)"
fi

echo "Pre-remove checks passed. Proceeding with remove..."
exit 0
