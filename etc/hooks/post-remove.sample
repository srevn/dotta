#!/usr/bin/env bash
#
# post-remove hook - Runs after removing paths or deleting a profile
#
# This script runs after dotta has removed paths from a profile or
# deleted a profile. Use it for audit logging, notifications, or
# cleanup of related external resources.
#
# Exit code is logged but the operation has already completed.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("remove")
#   DOTTA_PROFILE     - Profile name that was modified or deleted
#   DOTTA_PATH_COUNT  - Number of paths: the ones pre-remove was handed
#   DOTTA_PATH_0      - First path (0-indexed)
#   DOTTA_PATH_1      - Second path
#   DOTTA_PATH_N      - Nth path (where N = 0 to COUNT-1)
#   DOTTA_DRY_RUN     - Always "0" — post-remove does not fire on dry-run
#

set -euo pipefail

# Example: Append an audit-log line
audit_log="$HOME/.local/state/dotta/remove.log"
mkdir -p "$(dirname "$audit_log")"

{
    printf '%s\tprofile=%s\tcount=%s' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$DOTTA_PROFILE" \
        "$DOTTA_PATH_COUNT"
    for ((i=0; i<DOTTA_PATH_COUNT; i++)); do
        var_name="DOTTA_PATH_$i"
        printf '\t%s' "${!var_name}"
    done
    printf '\n'
} >> "$audit_log"

echo "Post-remove: audit entry appended to $audit_log"
exit 0
