#!/usr/bin/env bash
#
# pre-update hook - Runs before committing filesystem changes back to profiles
#
# This script runs before dotta commits filesystem-side changes back
# to a profile. Use it to validate modified files, check for sensitive
# data that may have leaked in, or create a recovery checkpoint.
#
# Exit with non-zero status to abort the update operation.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("update")
#   DOTTA_PROFILE     - Space-separated list of profiles being updated
#   DOTTA_PATH_COUNT  - Number of paths given, each a file or a directory;
#                       0 when updating the full workspace, so the checks
#                       below run only on an update that names its paths
#   DOTTA_PATH_0      - First path (0-indexed)
#   DOTTA_PATH_1      - Second path
#   DOTTA_PATH_N      - Nth path (where N = 0 to COUNT-1)
#   DOTTA_DRY_RUN     - "1" if dry-run, "0" otherwise
#

set -euo pipefail

echo "Pre-update: validating changes for profile(s) '$DOTTA_PROFILE'..."

# Check one regular file: no merge-conflict markers, and a shell script that
# passes shellcheck
check_file() {
    local file="$1"

    # Example: Refuse to commit files with merge-conflict markers
    if grep -qE '^(<<<<<<<|=======|>>>>>>>) ' "$file"; then
        echo "  ERROR: Conflict marker still present in: $file" >&2
        exit 1
    fi

    # Example: Lint shell scripts before committing
    case "$file" in
        *.sh|*.bash)
            if command -v shellcheck &>/dev/null; then
                shellcheck -S warning "$file" || {
                    echo "  ERROR: shellcheck failed for: $file" >&2
                    exit 1
                }
            fi
            ;;
    esac
}

# A path is a file or a directory: every regular file at or beneath it
for ((i=0; i<DOTTA_PATH_COUNT; i++)); do
    var_name="DOTTA_PATH_$i"
    path="${!var_name}"

    while IFS= read -r -d '' file; do
        check_file "$file"
    done < <(find "$path" -type f -print0 2>/dev/null)
done

echo "Pre-update validation passed!"
exit 0
