#!/usr/bin/env bash
#
# post-add hook - Runs after adding files or directories to a profile
#
# This script runs after dotta has added paths to a profile and committed
# them to its branch. Use it to publish the profile, trigger CI/CD, notify
# team, etc.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("add")
#   DOTTA_PROFILE     - Profile name that was modified
#   DOTTA_PATH_COUNT  - Number of paths, as given: each a file or a directory
#   DOTTA_PATH_0      - First path (0-indexed)
#   DOTTA_PATH_1      - Second path
#   DOTTA_PATH_N      - Nth path (where N = 0 to COUNT-1)
#   DOTTA_DRY_RUN     - Always "0" — post-add does not fire on dry-run
#

set -euo pipefail

echo "Post-add: profile '$DOTTA_PROFILE' was given $DOTTA_PATH_COUNT path(s):"
for ((i=0; i<DOTTA_PATH_COUNT; i++)); do
    var_name="DOTTA_PATH_$i"
    echo "  - ${!var_name}"
done

# Example: Publish the profile's branch (uncomment to enable). dotta committed
# the add itself, so the push is sync's: prefer 'dotta sync' over a raw
# 'git push' so divergence handling, hooks, and credential plumbing all behave
# consistently.
# if command -v dotta &>/dev/null; then
#     echo "Syncing profile '$DOTTA_PROFILE' to remote..."
#     dotta sync -p "$DOTTA_PROFILE" || {
#         echo "  WARNING: dotta sync returned non-zero exit code" >&2
#     }
# fi

echo "Post-add completed successfully!"
exit 0
