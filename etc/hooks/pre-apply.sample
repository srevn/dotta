#!/usr/bin/env bash
#
# pre-apply hook - Runs before applying profiles
#
# This script runs before dotta applies profiles to your system.
# Use it to backup current configurations, validate environment, etc.
#
# Exit with non-zero status to abort the apply operation.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("apply")
#   DOTTA_PROFILE     - Space-separated list of profiles being applied
#   DOTTA_PATH_COUNT  - Number of paths: every path the run changes on disk,
#                       each once; 0 where it changes nothing
#   DOTTA_PATH_0      - First path (0-indexed)
#   DOTTA_PATH_1      - Second path
#   DOTTA_PATH_N      - Nth path (where N = 0 to COUNT-1)
#   DOTTA_DRY_RUN     - "1" if dry-run, "0" otherwise
#

set -euo pipefail

if [[ "${DOTTA_DRY_RUN:-0}" == "1" ]]; then
    echo "Pre-apply: dry-run, skipping backup."
    exit 0
fi

# Example: Back up each file and link the run will overwrite or remove, as it
# stands now, under its own path — one you cannot read (a run under sudo) is
# left out. A directory on the list changes alone — created, its permissions
# set, or removed once empty — and every file in it the run touches is on the
# list too.
backup_dir="$HOME/.dotta-backups/apply-$(date +%Y%m%d-%H%M%S)"

for ((i=0; i<DOTTA_PATH_COUNT; i++)); do
    var_name="DOTTA_PATH_$i"
    path="${!var_name}"
    if [[ -L "$path" || -f "$path" ]]; then
        mkdir -p "$backup_dir${path%/*}"
        cp -a "$path" "$backup_dir$path" 2>/dev/null || true
    fi
done

if [[ -d "$backup_dir" ]]; then
    echo "Pre-apply: backed up what the run replaces to $backup_dir"
fi

# Example: Check disk space
available=$(df -h "$HOME" | awk 'NR==2 {print $4}')
echo "Available disk space: $available"

# Example: Validate environment
if [[ -z "${DOTTA_REPO_DIR:-}" ]]; then
    echo "Error: DOTTA_REPO_DIR not set!" >&2
    exit 1
fi

echo "Pre-apply checks passed. Proceeding with apply..."
exit 0
