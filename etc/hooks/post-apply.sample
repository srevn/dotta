#!/usr/bin/env bash
#
# post-apply hook - Runs after applying profiles
#
# This script runs after dotta has successfully applied profiles.
# Use it to reload services, restart applications, etc.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("apply")
#   DOTTA_PROFILE     - Space-separated list of profiles applied
#   DOTTA_PATH_COUNT  - Always "0" for apply
#   DOTTA_DRY_RUN     - Always "0" — post-apply does not fire on dry-run
#

set -euo pipefail

# What you should read on success goes to the terminal: dotta prints a hook's
# output only beside its failure (README, "Output is captured, not streamed").
# No terminal, no notice — and no failure.
to_terminal() { { printf '%s\n' "$*" > /dev/tty; } 2>/dev/null || true; }

echo "Post-apply: Reloading configurations..."

# Example: Shell configuration. A hook cannot reload the shell that ran dotta,
# so it tells the user how: for their login shell ($SHELL), never the bash this
# script runs in.
login_shell="${SHELL:-}"
case "${login_shell##*/}" in
    bash) to_terminal "Post-apply: run 'source ~/.bashrc' to pick up shell changes" ;;
    zsh)  to_terminal "Post-apply: run 'source ~/.zshrc' to pick up shell changes" ;;
esac

# Example: Reload tmux configuration
if command -v tmux &>/dev/null && [[ -n "${TMUX:-}" ]]; then
    echo "Reloading tmux configuration..."
    tmux source-file ~/.tmux.conf 2>/dev/null || true
fi

echo "Post-apply completed successfully!"
exit 0
