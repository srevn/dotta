#!/usr/bin/env bash
#
# post-update hook - Runs after committing filesystem changes back to profiles
#
# This script runs after dotta has committed filesystem-side changes
# back to the affected profile branches. Use it to push the new
# commits upstream, fire CI, or notify collaborators.
#
# A non-zero exit is warned, with the hook's output; the update has already
# completed.
#
# Environment variables provided by dotta:
#   DOTTA_REPO_DIR    - Path to dotta repository
#   DOTTA_CONFIG_FILE - Path to the configuration file the run read
#   DOTTA_COMMAND     - Command being executed ("update")
#   DOTTA_PROFILE     - Space-separated list of profiles that were updated
#   DOTTA_PATH_COUNT  - Number of paths given, each a file or a directory;
#                       0 when the full workspace was updated
#   DOTTA_PATH_0      - First path (0-indexed)
#   DOTTA_PATH_1      - Second path
#   DOTTA_PATH_N      - Nth path (where N = 0 to COUNT-1)
#   DOTTA_DRY_RUN     - Always "0" — post-update does not fire on dry-run
#

set -euo pipefail

echo "Post-update: profile(s) '$DOTTA_PROFILE' updated."

# Example: Push the updated profile branches upstream.
# Prefer 'dotta sync' over a raw 'git push' so divergence handling, hooks,
# and credential plumbing all behave consistently. A sync that fails exits the
# hook non-zero, so dotta warns with the sync's own output beside it.
if command -v dotta &>/dev/null; then
    echo "Syncing updated profiles to remote..."
    # shellcheck disable=SC2086
    if ! dotta sync -p $DOTTA_PROFILE; then
        echo "  ERROR: dotta sync failed" >&2
        exit 1
    fi
fi

echo "Post-update completed successfully!"
exit 0
